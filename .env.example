# Copy to web/.env.local (never commit real values)

# ── Chain (Arc) ─────────────────────────────────────────────
ARC_NETWORK=testnet                         # testnet | mainnet (mainnet ONLY with explicit human approval)
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000   # ERC-20 interface, 6 decimals
LUMBUNG_VAULT_ADDRESS=                      # from contracts/deployments/arc-testnet.json
OWNER_ADDRESS=                              # human approver (MetaMask/Rabby), NOT a Circle wallet
DEPLOYER_PRIVATE_KEY=                       # local deploy only; keep out of Vercel
NEXT_PUBLIC_ARC_EXPLORER=https://explorer.testnet.arc.io
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_LUMBUNG_VAULT_ADDRESS=

# ── Circle developer-controlled wallets ─────────────────────
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=                       # registered by the human; recovery file stored outside repo
CIRCLE_BLOCKCHAIN=ARC-TESTNET
CIRCLE_WALLET_SET_ID=
CIRCLE_AGENT_WALLET_ID=
CIRCLE_AGENT_WALLET_ADDRESS=

# ── Database ────────────────────────────────────────────────
DATABASE_URL=                               # Neon Postgres

# ── LLM (OpenAI-compatible chat completions) ────────────────
LLM_BASE_URL=                               # e.g. your 9router endpoint
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=12000

# ── OWatch integration ──────────────────────────────────────
OWATCH_WEBHOOK_SECRET=                      # shared HMAC secret
OWATCH_CALLBACK_URL=                        # optional push of redeem status
OWATCH_API_URL=                             # optional (P1 video views)
NEXT_PUBLIC_OWATCH_URL=                     # optional link to live OWatch app (for landing page hero CTA)

# ── Telegram (owner notifications) ──────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ── App ─────────────────────────────────────────────────────
APP_URL=http://localhost:3000
CRON_SECRET=

# ── Policy (off-chain rule thresholds; on-chain caps live in the contract) ──
POLICY_MAX_REDEEMS_24H=3
POLICY_NEW_ACCOUNT_MAX_MICRO=1000000
POLICY_LOW_RESERVE_RATIO=1.0
POLICY_CRITICAL_RESERVE_RATIO=0.5
POLICY_LOW_RESERVE_MAX_PAY_MICRO=1000000
POLICY_RISK_ESCALATE=0.7
CREATOR_MIN_VIEWS=100
